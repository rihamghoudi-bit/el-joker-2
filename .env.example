# EL JOKER 2.0 — copy to .env (never commit .env). Values here are placeholders only.

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# DATABASE_PATH=apps/api/data/eljoker.db

# --- Demo ---
# Enables demo-only tools (tamper simulation, reset). Always disabled when NODE_ENV=production.
DEMO_MODE=true
DEMO_STEP_DELAY_MS=700
# Comma-separated demo operator ids allowed to approve/reject (no production auth in this MVP).
DEMO_OPERATORS=ops-lead,field-coordinator
# PIN required to approve/reject (checked server-side, 5 wrong tries lock the mission 60 s).
# Empty in demo mode = documented demo PIN 0619. Required when DEMO_MODE=false.
DEMO_OPERATOR_PIN=
# Missions are in Tunisian dinars. Demo rate for a budget written in dollars (converted to dinars).
TND_PER_USD=3.1

# --- AI (Anthropic) --- never exposed to the frontend
AI_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=45000

# --- Hedera (TESTNET ONLY — any other value refuses to start) ---
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
# DER or hex private key of the testnet operator account. Never commit, never paste in chat.
HEDERA_PRIVATE_KEY=
# HCS topic for proofs. Create one with: npm run hedera:setup
HEDERA_TOPIC_ID=
# Testnet account that receives the scaled demo settlement (demo supplier account).
HEDERA_PAYEE_ACCOUNT_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# "simulated" forces the local stand-in ledger even when the values above are set (offline rehearsal).
LEDGER_MODE=auto
# 2-of-2 vault for payments above the autonomous limit: written by `npm run hedera:setup -- --vault`.
# The approver key is the human side of the vault. Never commit, never paste in chat.
HEDERA_VAULT_ACCOUNT_ID=
HEDERA_APPROVER_PRIVATE_KEY=
# HTS demo stablecoin (full offer amount instead of scaled HBAR): written by `npm run hedera:setup -- --stablecoin`.
HEDERA_STABLECOIN_TOKEN_ID=
HEDERA_STABLECOIN_SYMBOL=EJTND
HEDERA_STABLECOIN_DECIMALS=3
# Without the EJTND token: scaled HBAR settlement, proportional to the authorized offer: TND / 1000 * rate, capped.
# Default: 12,450 TND offer -> 0.996 HBAR; 49,800 TND -> 3.984 HBAR.
DEMO_SETTLEMENT_HBAR_PER_1000_TND=0.08
DEMO_SETTLEMENT_MAX_HBAR=10

# --- 3ASES policy overrides (fold into the policy hash/version) ---
AUTONOMOUS_PAYMENT_LIMIT_TND=15000
MAX_TRANSACTION_LIMIT_TND=75000
# Risk level at or above which a human must decide: MEDIUM | HIGH | CRITICAL
HUMAN_APPROVAL_THRESHOLD=HIGH
