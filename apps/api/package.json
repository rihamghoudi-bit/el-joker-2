{
  "name": "@eljoker/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:testnet": "cross-env RUN_TESTNET_TESTS=true vitest run --config vitest.testnet.config.ts",
    "demo:check": "tsx src/scripts/demoCheck.ts",
    "hedera:setup": "tsx src/scripts/hederaSetup.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eljoker/shared": "*",
    "@hashgraph/sdk": "^2.81.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
